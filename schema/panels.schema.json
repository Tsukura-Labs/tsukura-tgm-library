{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tgm.panels/1",
  "title": "TGM control panels (panel.json)",
  "type": "object",
  "required": ["schema", "panels"],
  "properties": {
    "schema": { "const": "tgm.panels/1" },
    "panels": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["uuid", "name"],
        "properties": {
          "uuid": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "maxLength": 160 },
          "sort": { "type": ["integer", "null"] },
          "json": { "type": ["string", "object", "array"] }
        }
      }
    }
  }
}
