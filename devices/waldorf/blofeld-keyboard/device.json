            "de": "Pedal-Eingang",
            "en": "Pedal input"
          }
        },
        {
          "type": "power",
          "count": 1,
          "note": {
            "de": "Netzbuchse",
            "en": "Power supply socket"
          }
        }
      ]
    }
  },
