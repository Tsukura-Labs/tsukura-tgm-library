    "info": {
      "schema": "tgm.deviceinfo/1",
      "source": "waldorf-press",
      "text": {
        "de": {
          "description": "Der Blofeld Keyboard ist die Variante des digitalen Waldorf-Synthesizers Blofeld mit eigener Tastatur, Pitch-Bend- und Modulationsrad. Klangerzeugung und MIDI-Umsetzung entsprechen dem Blofeld Desktop. Zusätzlich gibt es eine MIDI-Out-Buchse zur Steuerung externer Klangerzeuger und einen Pedal-Eingang für ein Sustain-Pedal.",
          "features": [
            "Drei Oszillatoren pro Stimme mit Wavetable-Wellenformen (68 Wavetables früherer Waldorf-Synthesizer)",
            "Zwei Filter mit wählbarem Routing (seriell/parallel)",
            "Drei LFOs und vier Hüllkurven (Filter, Amp, Env 3, Env 4)",
            "Zwei Effektslots, Arpeggiator mit Step-Daten",
            "Multi-Modus mit 16 Parts und 128 Multi-Programmen",
            "Sound-Bänke A bis H mit je 128 Klängen",
            "Kategorie-Suche für Klänge",
            "USB-MIDI-Anschluss; Firmware-Update per SysEx",
            "Tastatur mit Pitch-Bend- und Modulationsrad, Oktavtasten"
          ]
        },
        "en": {
          "description": "The Blofeld Keyboard is the version of Waldorf's digital Blofeld synthesizer with its own keyboard, pitch bend wheel and modulation wheel. The sound engine and MIDI implementation match the Blofeld Desktop. It additionally has a MIDI Out jack for controlling external sound modules and a pedal input for a sustain pedal.",
          "features": [
            "Three oscillators per voice with wavetable waveforms (68 wavetables from earlier Waldorf synthesizers)",
            "Two filters with selectable routing (serial/parallel)",
            "Three LFOs and four envelopes (Filter, Amp, Env 3, Env 4)",
            "Two effect slots, arpeggiator with step data",
            "Multi mode with 16 parts and 128 Multi programs",
            "Sound banks A to H with 128 sounds each",
            "Category search for sounds",
            "USB MIDI connection; firmware updates via SysEx",
            "Keyboard with pitch bend and modulation wheels, octave buttons"
          ]
        }
      },
      "ports": [
        {
          "type": "midi-in",
          "count": 1,
          "note": {
            "de": "MIDI-In-Buchse",
            "en": "MIDI In jack"
          }
        },
        {
          "type": "midi-out",
          "count": 1,
          "note": {
            "de": "MIDI-Out-Buchse",
            "en": "MIDI Out jack"
          }
        },
        {
          "type": "usb",
          "count": 1,
          "note": {
            "de": "USB-Anschluss (MIDI)",
            "en": "USB port (MIDI)"
          }
        },
        {
          "type": "audio-out",
          "count": 2,
          "note": {
            "de": "Stereo-Ausgang links/rechts (nur links = mono)",
            "en": "Stereo output left/right (left only = mono)"
          }
        },
        {
          "type": "headphones",
          "count": 1,
          "note": {
            "de": "Stereo-Kopfhörerbuchse",
            "en": "Stereo headphone jack"
          }
        },
        {
          "type": "sustain-pedal",
          "count": 1,
