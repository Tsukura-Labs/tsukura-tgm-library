    "info": {
      "schema": "tgm.deviceinfo/1",
      "source": "waldorf-press",
      "text": {
        "de": {
          "description": "Der Streichfett ist ein Streicher-Synthesizer von Waldorf (Handbuch-Revision Juli 2014) im Stil klassischer String-Maschinen, ergänzt um einen Solo-Synthesizer-Teil. Der Klang wird über die Bereiche Strings, Solo und Effekt geformt. Zwölf Speicherplätze liegen in drei Bänken (A, B, C) zu je vier Klängen. Er wird per USB oder Netzteil versorgt und über MIDI oder USB gespielt.",
          "features": [
            "String-Ensemble mit Registration, Octaves, Release und Crescendo",
            "Solo-Teil mit Tone, Tremolo, Split, Sustain, Attack und Decay",
            "Effektbereich mit Reverb, Phaser und Animate",
            "12 Speicherplätze in 3 Bänken (A-C) zu je 4 Klängen",
            "Sound-Dump über MIDI/USB-MIDI",
            "MIDI-Kanal per Tastendruck einstellbar, Omni-Modus",
            "USB-Anschluss für Strom und MIDI"
          ]
        },
        "en": {
          "description": "The Streichfett is a Waldorf string synthesizer (manual revision July 2014) in the style of classic string machines, extended by a solo synthesizer section. The sound is shaped in the Strings, Solo and Effect sections. Twelve memory locations are arranged in three banks (A, B, C) of four sounds each. It is powered over USB or a supplied adapter and played via MIDI or USB.",
          "features": [
            "String ensemble with registration, octaves, release and crescendo",
            "Solo section with tone, tremolo, split, sustain, attack and decay",
            "Effect section with reverb, phaser and animate",
            "12 memory locations in 3 banks (A-C) of 4 sounds",
            "Sound dump via MIDI/USB MIDI",
            "MIDI channel set by key press, omni mode",
            "USB port for power and MIDI"
          ]
        }
      },
