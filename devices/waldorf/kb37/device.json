    "info": {
      "schema": "tgm.deviceinfo/1",
      "source": "waldorf-press",
      "text": {
        "de": {
          "description": "Das KB37 ist eine 37-Tasten-Controller-Tastatur von Waldorf mit eingebautem Modulrahmen für Eurorack-/A-100-Module und CV/Gate-Schnittstelle. Es erzeugt aus MIDI (Tastatur, DIN oder USB) Pitch, Gate, Clock, Reset, Velocity, Aftertouch, Bend, Mod-Rad, Sensor und drei frei lernbare Controller-Ausgänge. Dazu kommen ein Arpeggiator, ein Stereo-Audioweg mit Kopfhörerausgang und eine Sustain-Pedal-Buchse.",
          "features": [
            "37 Tasten mit Pitch- und Mod-Rad",
            "Modulrahmen mit Bus für Eurorack/A-100",
            "CV/Gate: Pitch 1 V/Okt., Gate, Clock, Reset, Velocity, Aftertouch, Bend, Wheel",
            "Ctrl-X/Y/Z: frei lernbare MIDI-CC-Ausgänge (Standard CC 2, 4, 11)",
            "Ctrl-X optional als zweiter Pitch-Ausgang (Duophon)",
            "Arpeggiator, per MIDI-CC steuerbar",
            "Stereo-Audioeingänge, Hauptausgang, Kopfhörer",
            "MIDI In/Out/Thru und USB"
          ]
        },
        "en": {
          "description": "The KB37 is a 37-key controller keyboard from Waldorf with a built-in module frame for Eurorack/A-100 modules and a CV/gate interface. From MIDI (keyboard, DIN or USB) it generates pitch, gate, clock, reset, velocity, aftertouch, bend, mod wheel, sensor and three freely learnable controller outputs. It also has an arpeggiator, a stereo audio path with headphone output and a sustain pedal jack.",
          "features": [
            "37 keys with pitch and mod wheels",
            "Module frame with bus for Eurorack/A-100",
            "CV/gate: pitch 1 V/oct, gate, clock, reset, velocity, aftertouch, bend, wheel",
            "Ctrl-X/Y/Z: learnable MIDI CC outputs (default CC 2, 4, 11)",
            "Ctrl-X optionally second pitch output (duophonic)",
            "Arpeggiator, controllable via MIDI CC",
            "Stereo audio inputs, main outputs, headphones",
            "MIDI In/Out/Thru and USB"
          ]
        }
      },
