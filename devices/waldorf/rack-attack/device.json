    "info": {
      "schema": "tgm.deviceinfo/1",
      "source": "waldorf-press",
      "text": {
        "de": {
          "description": "Der Rack Attack ist ein Percussion-Synthesizer im 19-Zoll-Gehäuse aus der Q-Familie, gedacht für lebendige Rhythmen und Drum-Sounds. Er bietet Oszillatoren mit synthetischen Wellenformen und drei Hi-Hat-Samples, einen Crack-Modulator für Handclaps, Filter, Effekte und einen Pattern-Spieler mit Step-Listen. Es gibt 50 Programme und drei Stereo-Ausgänge. Die Handbuchversion 1.04 stammt von Januar 2003.",
          "features": [
            "Percussion-Synthesizer",
            "Synthetische Wellenformen plus drei Hi-Hat-Samples",
            "Crack-Modulator für Handclaps",
            "Sample-&-Hold-Generator und Rauschen",
            "Pattern-Spieler mit Step-Listen bis 128 Schritten",
            "Effekte inkl. Sample-Rate-Reduktion",
            "50 Programme",
            "Drei Stereo-Ausgänge und ein Stereo-Eingang",
            "Peek-Modus zum Prüfen von Reglerwerten"
          ]
        },
        "en": {
          "description": "The Rack Attack is a rack-mounted percussion synthesizer from the Q family, made for lively rhythms and drum sounds. It features oscillators with synthetic waveforms and three hi-hat samples, a Crack Modulator for hand claps, filters, effects and a pattern player with step lists. It has 50 programs and three stereo outputs. Manual version 1.04 is dated January 2003.",
          "features": [
            "Percussion synthesizer",
            "Synthetic waveforms plus three hi-hat samples",
            "Crack Modulator for hand claps",
            "Sample & Hold generator and noise",
            "Pattern player with note lists up to 128 steps",
            "Effects incl. sample-rate reduction",
            "50 programs",
            "Three stereo outputs and one stereo input",
            "Peek mode to inspect control values"
          ]
        }
      },
